# ------------------------------------------------------------------
# Пример конфигурации. Скопируйте файл в .env и заполните значения.
#   cp .env.example .env        (Linux/macOS)
#   Copy-Item .env.example .env (Windows PowerShell)
# Файл .env добавлен в .gitignore и НЕ попадает в репозиторий.
# ------------------------------------------------------------------

# --- Приложение ----------------------------------------------------
APP_NAME=Конференция
APP_ENV=local
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000

# --- База данных ---------------------------------------------------
# Вариант 1 (по умолчанию, без Docker): локальный файл SQLite
DATABASE_URL=sqlite+pysqlite:///./data/conference.db

# Вариант 2 (Docker / PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://conference:conference@db:5432/conference
# DATABASE_URL=postgresql+psycopg2://conference:conference@127.0.0.1:5432/conference

# --- Учётная запись администратора (создаётся при первом запуске) ---
# Адрес должен быть синтаксически корректным: служебные зоны (.local,
# .internal, .localhost) не проходят проверку формата e-mail.
ADMIN_EMAIL=organizer@example.com
ADMIN_PASSWORD=Conference2026
ADMIN_FULL_NAME=Администратор программы

# Единый пароль демонстрационных учётных записей всех ролей:
# организатор (ADMIN_EMAIL), listener@example.com, speaker@example.com,
# reviewer@example.com. В эксплуатации пароль обязательно заменить.
DEMO_PASSWORD=Conference2026

# --- Наполнение демонстрационными данными --------------------------
SEED_DEMO_DATA=true

# --- Правила предметной области (значения по умолчанию) ------------
# Максимальное число участников в одной секции
SECTION_CAPACITY=3
# Время (в часах), в течение которого бронь гостиницы должна быть подтверждена
HOTEL_CONFIRMATION_HOURS=48
# Максимальный размер файла тезисов, КБ
ABSTRACT_MAX_SIZE_KB=512
